# Keep the real .env private; never commit credentials.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/shortlist.sqlite
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_TAB=Jobs
# Recommended: absolute path to a private JSON key outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative: set these through a hosting secret manager, not frontend code.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
